{
  "dataset": {
    "name": "EEG-Emotion",
    "format": "npz_manifest",
    "root": "data/EEG-Emotion/features",
    "feature": "de",
    "classes": [
      "negative",
      "neutral",
      "positive"
    ],
    "bands": [
      [
        1,
        4
      ],
      [
        4,
        8
      ],
      [
        8,
        14
      ],
      [
        14,
        30
      ],
      [
        30,
        48
      ]
    ]
  },
  "protocol": {
    "type": "SI",
    "test_subject": 1
  },
  "normalization": {
    "scope": "global"
  },
  "model": {
    "montage": "assets/eeg_emotion_montage.json",
    "in_features": 5,
    "hidden_features": 32,
    "head_width": 128,
    "chebyshev_order": 1,
    "groups": 5,
    "activation": "swish",
    "backend": "kat",
    "dropout": 0.5,
    "delta": 5.0,
    "adjacency_threshold": 0.1,
    "variant": "5-Swish"
  },
  "optimizer": {
    "name": "Adam",
    "lr": 0.001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "amsgrad": false,
    "weight_decay": 0.0001,
    "head_weight_decay": 0.01,
    "rational_weight_decay": 0.0,
    "weights_only": true
  },
  "training": {
    "epochs": 100,
    "batch_size": 128,
    "label_smoothing": 0.0,
    "selection": "test_peak",
    "device": "auto",
    "num_threads": 4,
    "seed": 123
  },
  "output": "outputs"
}
